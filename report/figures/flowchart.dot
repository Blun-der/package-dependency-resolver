// Figure 3.3: flowchart of the main logic (pdr --check)
digraph flowchart {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.3, pad=0.2, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10.5, shape=box, style="filled", fillcolor="#f2f2f2", color="#7a7a7a", margin="0.14,0.06"];
  edge  [color="#555555", arrowsize=0.7, fontname="Helvetica", fontsize=9.5];

  start  [label="Start: pdr [folder] --check", shape=oval, fillcolor="#ffffff"];
  args   [label="Read the arguments\n(folder, flags, --rules FILE)"];
  okargs [label="Arguments valid?", shape=diamond, fillcolor="#ffffff"];
  usage  [label="Print usage, exit 2", shape=box, style="rounded,filled", fillcolor="#fde3e1", color="#d0342c"];
  rulesq [label="pdr.rules or\n--rules given?", shape=diamond, fillcolor="#ffffff"];
  parse  [label="Parse the rules file"];
  load   [label="Load every code file"];
  any    [label="Any code file?", shape=diamond, fillcolor="#ffffff"];
  each   [label="For each file: parse imports,\ntag when each runs, resolve each import"];
  build  [label="Build the graph of all imports\nand the graph of load-time imports"];
  scc    [label="Tarjan SCC on the load-time graph;\nfor each loop: one concrete cycle + greedy fix"];
  rest   [label="Build order, bitset reachability,\nunused files, rule check"];
  print  [label="Print each problem as file:line: message"];
  probs  [label="Cycles, broken imports or\nrule violations (not allowed)?", shape=diamond, fillcolor="#ffffff"];
  fail   [label="Print FAILED, exit 1", shape=box, style="rounded,filled", fillcolor="#fde3e1", color="#d0342c"];
  pass   [label="Print OK, exit 0", shape=box, style="rounded,filled", fillcolor="#e1f3e8", color="#1b8a5a"];

  start -> args -> okargs;
  okargs -> usage [label=" no"];
  okargs -> rulesq [label=" yes"];
  rulesq -> parse [label=" yes"];
  rulesq -> load [label=" no"];
  parse -> load;
  parse -> usage [label=" bad line", style=dashed];
  load -> any;
  any -> usage [label=" no", style=dashed];
  any -> each [label=" yes"];
  each -> build -> scc -> rest -> print -> probs;
  probs -> fail [label=" yes"];
  probs -> pass [label=" no"];
}
