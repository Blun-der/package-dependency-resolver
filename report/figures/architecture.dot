// Figure 3.1: system architecture
digraph architecture {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=12, nodesep=0.35, ranksep=0.42, pad=0.2, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f2f2f2", color="#7a7a7a", margin="0.16,0.08"];
  edge  [color="#555555", arrowsize=0.7];

  input   [label="Project folder\n(.py  .js .ts  .c .cpp .h)  +  pdr.rules", shape=folder, fillcolor="#ffffff"];
  loader  [label="Loader\nwalks the folder, skips node_modules, venv, .git ..."];
  parser  [label="Parser\nmasks comments and strings, reads imports,\ntags when each import runs (load / later / type-checking)"];
  resolver[label="Resolver\nimport  ->  project file | outside package | broken\n(hash maps: module index, path endings)"];
  graphs  [label="Dependency graphs (adjacency lists + reverse lists)\nall imports   |   load-time imports", fillcolor="#dce8f8", color="#2a78d6", penwidth=1.4];

  subgraph cluster_alg {
    label="Analyses"; fontname="Helvetica-Bold"; style="rounded,dashed"; color="#9a9a9a";
    tarjan  [label="Tarjan SCC\ncircular imports"];
    fix     [label="Greedy cycle fix\nimports to remove"];
    kahn    [label="Kahn + min-heap\nbuild order, layers"];
    bits    [label="Bitset reachability\ncritical files"];
    bfs     [label="BFS\nwhy A needs B, impact"];
    unused  [label="Multi-source BFS\nunused files"];
    rules   [label="Path trie\narchitecture rules"];
    trie    [label="Trie\nfile search"];
  }

  out [label="Outputs\ninteractive menu  |  --report  |  --check (exit code for CI)  |  --json  |  --dot (Graphviz)", shape=box, fillcolor="#ffffff"];

  input -> loader -> parser -> resolver -> graphs;
  graphs -> tarjan -> fix;
  graphs -> kahn; graphs -> bits; graphs -> bfs; graphs -> unused; graphs -> rules; graphs -> trie;
  {tarjan fix kahn bits bfs unused rules trie} -> out [color="#9a9a9a"];
}
